: 1787613807:0;#!/bin/bash\
# Fetch the latest .rpm download URL from the GitHub API\
RPM_URL=$(curl -s https://github.com \\
  | grep -oP '"browser_download_url": "\K[^"]+\.rpm' \\
  | head -n 1)\
\
if [ -z "$RPM_URL" ]; then\
    echo "Error: Could not find an RPM package in the latest release."\
    exit 1\
fi\
\
echo "Found latest release: $RPM_URL"\
echo "Installing/Updating via DNF..."\
sudo dnf install -y "$RPM_URL"\

